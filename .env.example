APP_NAME="Portfolio Heddy Mameri"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votredomaine.fr

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@votredomaine.fr
MAIL_FROM_NAME="${APP_NAME}"

# Identifiants du compte admin Filament
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — indiquer l'URL de prod
CORS_ALLOWED_ORIGINS="${APP_URL}"
